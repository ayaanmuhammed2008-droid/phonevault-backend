# ---------------------------------------------------
# PhoneVault Backend - Environment Variables Example
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/phonevault?schema=public"

# Port the Express server will listen on
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Secret key required in the "x-admin-api-key" header to access /api/admin/* routes
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY="replace_this_with_a_long_random_secret"

# Comma-separated list of allowed origins for CORS (your Builder.io frontend URL(s))
# Example: "https://your-app.builder.io,http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
